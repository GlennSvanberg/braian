# Kopiera till .env och byt alla värden. .env är gitignorerad.
# Värdena gäller bara den lokala utvecklingsmiljön.

POSTGRES_USER=braian
POSTGRES_PASSWORD=byt-mig
POSTGRES_DB=braian
POSTGRES_READONLY_PASSWORD=byt-mig-ocksa
# 5433 för att inte krocka med en lokalt installerad Postgres på 5432.
POSTGRES_HOST_PORT=5433

TYPESENSE_API_KEY=byt-mig-typesense

# Från värddatorn. I devcontainern skrivs dessa över med tjänstenamnen (postgres, redpanda, typesense).
DATABASE_URL=postgres://braian:byt-mig@localhost:5433/braian
# Integrationstester skapar en egen databas. URL:en ska peka på underhållsdatabasen postgres.
BRAIAN_TEST_DATABASE_URL=postgres://braian:byt-mig@localhost:5433/postgres
KAFKA_BROKERS=localhost:19092
TYPESENSE_URL=http://localhost:8108
# Tomt: sökningen använder aliaset braian_objects. Tester sätter ett eget alias.
# BRAIAN_SEARCH_ALIAS=
# Antal syntetiska bygg- och friluftsobjekt utöver hjälteobjekten. 0 hoppar över.
# BRAIAN_SEED_COUNT=3000

# Postgres-MCP i Cursor: läsroll, bara utvecklingsdatabasen.
DATABASE_URI=postgresql://braian_readonly:byt-mig-ocksa@localhost:5433/braian

RUST_LOG=info,braian=debug

# API. Redpanda Console lyssnar på 8080, därför 8090.
BRAIAN_API_ADDR=127.0.0.1:8090
BRAIAN_RELAY_ADDR=127.0.0.1:8091
# Relayns /healthz blir 503 när slot-laggen passerar det här (byte). Standard 64 MiB.
# BRAIAN_RELAY_LAG_LIMIT_BYTES=67108864
# Två Postgres-pooler. Interaktiv trafik och bulk delar inte anslutningar.
# BRAIAN_POOL_INTERACTIVE=24
# BRAIAN_POOL_BULK=8
# Paus mellan bulk-slice:ar när ingen interaktiv trafik pågår, och taket när den pågår.
# Väntan växer med STEP per pågående anrop och stannar vid MAX, så importen inte fastnar.
# BRAIAN_BULK_YIELD_MS=1
# BRAIAN_BULK_YIELD_STEP_MS=4
# BRAIAN_BULK_YIELD_MAX_MS=25
# BRAIAN_BULK_JOBS=1
# BRAIAN_BULK_QUEUE=4
# BRAIAN_BULK_CHUNK=25
# Indexern. Interaktiva spåret är de tre första. Bulk-spåret importerar större sjok
# och väntar in det interaktiva topicet, högst YIELD_MAX millisekunder.
# BRAIAN_INDEXER_BATCH=200
# BRAIAN_INDEXER_IMPORT_BATCH=100
# BRAIAN_INDEXER_IMPORT_CONCURRENCY=4
# BRAIAN_INDEXER_BULK_BATCH=2000
# BRAIAN_INDEXER_BULK_IMPORT_BATCH=500
# BRAIAN_INDEXER_BULK_IMPORT_CONCURRENCY=4
# BRAIAN_INDEXER_BULK_YIELD_MAX_MS=100
# Citat behövs: semikolon annars delas raden av skalet. En agent måste namnge personen: handle:agent@person:token
BRAIAN_DEV_TOKENS="ada:human:byt-mig;bot:agent@ada:byt-mig-agent"
# Demokontot skapas av `braian all` / `braian seed`. Byt lösenordet. Inget hemligt värde hör hemma i koden.
BRAIAN_DEMO_EMAIL=admin@braian.local
BRAIAN_DEMO_PASSWORD=braian-demo
BRAIAN_DEMO_TOKEN=braian-demo-token
# In-app-agenten. Lämna nyckeln tom: gränssnittet säger då till på svenska i stället för att krascha.
BRAIAN_AGENT_MODEL=gpt-6-luna
OPENAI_API_KEY=
BRAIAN_AGENT_MOCK=0
# 1 bara bakom HTTPS.
BRAIAN_COOKIE_SECURE=0
